<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      TEMPORARY, FOR LOCAL TESTING ONLY.
      Plain HTTP (no TLS) is allowed ONLY to the developer's own device (127.0.0.1) and to the
      Android emulator's alias for the host machine's loopback (10.0.2.2). Nothing else is affected:
      every other domain still requires HTTPS (base-config below).
      >>> Remove this <domain-config> block before shipping a real release. <<<
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
