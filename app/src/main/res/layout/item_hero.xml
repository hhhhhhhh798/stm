<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="22dp"
    android:foreground="@drawable/bg_home_hero_outline"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_premium">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/heroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_hero_overlay"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp"
            android:paddingTop="42dp"
            android:gravity="end">

            <TextView
                android:id="@+id/heroRating"
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:drawableLeft="@drawable/ic_rating_star"
                android:drawablePadding="3dp"
                android:background="@drawable/bg_hero_rating"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="30sp"
                android:shadowColor="#DD000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/heroDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:shadowColor="#DD000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layoutDirection="ltr"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- "Watch now" keeps its exact size/background/text style; the only
                     addition is the black play triangle next to the label. -->
                <LinearLayout
                    android:id="@+id/btnWatch"
                    android:layout_width="124dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_home_watch"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_play"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/play_now"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/button_ink"
                        android:includeFontPadding="true"
                        android:maxLines="1"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnMyList"
                    android:layout_width="116dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_home_list"
                    android:text="@string/add_to_watchlist"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:paddingHorizontal="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
