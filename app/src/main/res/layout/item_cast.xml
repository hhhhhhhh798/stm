<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginEnd="10dp">
    <androidx.cardview.widget.CardView
        android:layout_width="118dp" android:layout_height="154dp"
        app:cardCornerRadius="@dimen/radius_panel" app:cardElevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <ImageView android:id="@+id/castImage" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:contentDescription="@null"/>
    </androidx.cardview.widget.CardView>
    <TextView android:id="@+id/castName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:textColor="@color/text_primary" android:textSize="12sp"
        android:textStyle="bold" android:gravity="start" android:includeFontPadding="false"
        android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/castCharacter" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="@color/text_muted" android:textSize="12sp"
        android:gravity="start" android:includeFontPadding="false"
        android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
