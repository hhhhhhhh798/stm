<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/categoryBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_transparent"
                android:padding="11dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/categoryTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical|start"
                android:text="@string/category_action"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/categoryFilter"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/bg_circle_transparent"
                android:src="@drawable/ic_filter"
                android:tint="@color/comic_peach"
                android:contentDescription="@string/filter_by_category"/>
            <ImageView
                android:id="@+id/globalSearchButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/bg_circle_transparent"
                android:src="@drawable/ic_search"
                android:tint="@color/comic_peach"
                android:contentDescription="@string/search"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chipTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginEnd="8dp"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_chip"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chip_most_watched"/>

                <TextView
                    android:id="@+id/chipTopRated"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginEnd="8dp"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_chip"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chip_top_rated"/>

                <TextView
                    android:id="@+id/chipLatest"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginEnd="8dp"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_chip"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/category_latest"/>

                <TextView
                    android:id="@+id/chipSuggested"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginEnd="8dp"
                    android:minWidth="72dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_chip"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chip_suggested"/>
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="104dp" />

            <ProgressBar
                android:id="@+id/categoryProgress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/comic_peach"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/categoryLoadMoreProgress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:indeterminateTint="@color/comic_peach"
                android:visibility="gone" />

            <TextView
                android:id="@+id/categoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:gravity="center"
                android:text="@string/category_empty"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
