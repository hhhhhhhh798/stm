<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netflix_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/seriesBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_transparent"
                android:padding="11dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical|start"
                android:text="@string/series"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/seriesViewToggle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_transparent"
                android:padding="10dp"
                android:src="@drawable/ic_view_list"
                android:tint="@color/comic_peach"
                android:contentDescription="@string/series_view_toggle"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_search_premium"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#A1A6AE"
                android:layout_marginEnd="10dp"/>

            <EditText
                android:id="@+id/editSeriesSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/series_search_hint"
                android:textColorHint="#6F747C"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seriesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="104dp"/>

            <ProgressBar
                android:id="@+id/seriesProgress"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/comic_peach"
                android:visibility="gone"/>

            <ProgressBar
                android:id="@+id/seriesLoadMore"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="92dp"
                android:indeterminateTint="@color/comic_peach"
                android:visibility="gone"/>

            <!-- Empty / error state (one view, texts swapped in code) -->
            <LinearLayout
                android:id="@+id/seriesState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_circle_panel"
                    android:padding="26dp"
                    android:src="@drawable/ic_series"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/seriesStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/seriesStateSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/seriesRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:minWidth="140dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:background="@drawable/bg_filter_chip"
                    android:text="@string/retry"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
