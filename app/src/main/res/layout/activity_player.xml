<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="texture_view" />

    <!-- Initial loading: intentionally icon-only. -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/comic_peach" />
    </FrameLayout>

    <!-- Gesture feedback: seek feedback is placed on the left/right edge by direction. -->
    <LinearLayout
        android:id="@+id/gestureFeedbackOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/ivGestureFeedbackIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_fast_forward"
            app:tint="@color/comic_peach" />
        <TextView
            android:id="@+id/tvGestureFeedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gestureBrightnessHud"
        android:layout_width="78dp"
        android:layout_height="214dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gestureBrightnessIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|center_horizontal"
            android:src="@drawable/ic_brightness_hud"
            android:contentDescription="@string/brightness"
            app:tint="@color/comic_peach" />

        <com.stream.master.VerticalLevelView
            android:id="@+id/gestureBrightnessProgress"
            android:layout_width="28dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:contentDescription="@string/brightness" />

        <TextView
            android:id="@+id/gestureBrightnessText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/gestureVolumeHud"
        android:layout_width="78dp"
        android:layout_height="214dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gestureVolumeIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|center_horizontal"
            android:src="@drawable/ic_volume_hud"
            android:contentDescription="@string/volume"
            app:tint="@color/comic_peach" />

        <com.stream.master.VerticalLevelView
            android:id="@+id/gestureVolumeProgress"
            android:layout_width="28dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:contentDescription="@string/volume" />

        <TextView
            android:id="@+id/gestureVolumeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- Only shown after a real unrecoverable error. -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/btnRetry"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_circle_peach"
            android:contentDescription="@string/retry"
            android:src="@drawable/ic_play"
            app:tint="#17110E" />
    </LinearLayout>

    <!-- End state: action only, no unnecessary text. -->
    <FrameLayout
        android:id="@+id/endOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/btnReplay"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_peach"
            android:contentDescription="@string/replay"
            android:src="@drawable/ic_play"
            app:tint="#17110E" />
    </FrameLayout>

    <!-- Shown only while controls are locked; the sole way back is this button. -->
    <FrameLayout
        android:id="@+id/lockedOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="18dp"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/btnUnlock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_transparent"
            android:contentDescription="@string/lock_controls"
            android:padding="11dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/comic_peach" />
    </FrameLayout>

    <!-- Netflix-inspired cinematic controller: minimal, large hit targets, no labels unless useful. -->
    <RelativeLayout
        android:id="@+id/customControllerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/topGradient"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_alignParentTop="true" />
        <View
            android:id="@+id/bottomGradient"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_alignParentBottom="true" />

        <RelativeLayout
            android:id="@+id/topBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_circle_transparent"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/topRightActions"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvMovieTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvMovieSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topRightActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_quality_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="56dp"
                    android:paddingHorizontal="14dp"
                    android:text="Auto"
                    android:textColor="@color/comic_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/room_mic"
                    android:padding="9dp"
                    android:src="@drawable/ic_mic_off"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnSubtitles"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/subtitles"
                    android:padding="8dp"
                    android:src="@drawable/ic_subtitles_outline"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnLock"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/lock_controls"
                    android:padding="9dp"
                    android:src="@drawable/ic_lock_open"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_menu_3lines"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/centerControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/rewind_10"
                    android:padding="14dp"
                    android:src="@drawable/ic_fast_rewind"
                    app:tint="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="19dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:includeFontPadding="false"
                    android:text="10"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="34dp"
                android:background="@drawable/bg_circle_peach"
                android:contentDescription="@string/play_pause"
                android:src="@drawable/ic_pause"
                app:tint="#17110E" />
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">
                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/forward_10"
                    android:padding="14dp"
                    android:src="@drawable/ic_fast_forward"
                    app:tint="@color/text_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="19dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:includeFontPadding="false"
                    android:text="10"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/chipsContainer"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvCurrentPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/comic_peach"
                android:thumbTint="@color/comic_peach" />
            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/chipServer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/chipEpisodes"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
