<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="124dp"
    android:layout_marginBottom="2dp"
    android:foreground="@drawable/bg_card_frame"
    android:clipToOutline="true"
    android:stateListAnimator="@animator/card_press"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/movie_card_surface">

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/continueImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null"/>
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/continue_card_overlay"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
            <TextView android:id="@+id/continueTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/continueMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/continueProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom" android:layout_marginStart="@dimen/card_border_width" android:layout_marginEnd="@dimen/card_border_width" android:layout_marginBottom="@dimen/card_border_width" android:max="100" android:progressTint="@color/comic_peach" android:progressBackgroundTint="#66FFFFFF"/>
        <FrameLayout android:id="@+id/continuePlay" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/bg_continue_play_comic"
            android:elevation="2dp" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_play" android:contentDescription="@string/play_now" app:tint="#FFFFFF"/>
        </FrameLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
