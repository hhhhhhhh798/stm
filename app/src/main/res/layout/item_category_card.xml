<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="150dp"
    android:layout_marginEnd="10dp"
    android:foreground="@drawable/bg_card_frame"
    android:stateListAnimator="@animator/card_press"
    app:cardCornerRadius="@dimen/movie_card_radius"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/movie_card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/catImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/catLabel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingStart="@dimen/card_overlay_inset"
            android:paddingEnd="@dimen/card_overlay_inset"
            android:paddingBottom="@dimen/card_border_width"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@color/movie_card_surface"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
