<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btnLangEn"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <ImageView
        android:id="@+id/imgCheckEn"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:src="@drawable/ic_check"
        android:tint="@color/accent_red"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:text="@string/lang_en"
        android:textColor="@color/settings_row_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lang_en_short"
        android:textColor="@color/settings_row_text_muted"
        android:textSize="12sp"/>
    <ImageView
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginStart="14dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_muted"/>
</LinearLayout>
