<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- النقطة النشطة (الحمراء) -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/comic_peach" /> 
        </shape>
    </item>
    <!-- النقطة غير النشطة (الرمادية الشفافة) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" /> <!-- أبيض شفاف (رمادي ناعم) -->
        </shape>
    </item>
</selector>
