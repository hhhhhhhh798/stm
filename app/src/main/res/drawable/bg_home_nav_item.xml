<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Compact, fully opaque selection tile centered inside the navigation item. -->
    <item android:state_checked="true">
        <layer-list>
            <item android:left="7dp" android:top="5dp" android:right="7dp" android:bottom="5dp">
                <shape>
                    <solid android:color="@color/comic_peach"/>
                    <corners android:radius="15dp"/>
                    <stroke android:width="1dp" android:color="#FFE3D0"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
</selector>
