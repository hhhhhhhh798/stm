<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="2dp">
                <shape android:shape="rectangle"><solid android:color="@color/comic_peach"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle"><solid android:color="@color/comic_line"/></shape>
            </item>
        </layer-list>
    </item>
</selector>
